# ============================================================
# Gmail MCP server — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ----- Transport -----
# stdio = local single-user dev mode (no auth)
# http  = remote multi-tenant mode (MCP OAuth flow)
GMAIL_MCP_TRANSPORT=http

GMAIL_MCP_HTTP_HOST=0.0.0.0
GMAIL_MCP_HTTP_PORT=8765

# Public base URL — what users hit in their browser (and what Google redirects to).
# Must match the protocol/host nginx serves.
GMAIL_MCP_PUBLIC_BASE_URL=https://gmail-mcp.example.com

# ----- Encryption -----
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DO NOT change after users have signed in (existing tokens become unrecoverable).
GMAIL_MCP_ENCRYPTION_KEY=replace_me_with_a_real_fernet_key

# ----- Google OAuth client (Web application type) -----
GMAIL_MCP_OAUTH_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GMAIL_MCP_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# This is the redirect URI used by the LEGACY add-account flow (gmail_authenticate
# tool for connecting additional accounts after initial sign-in).
# Add BOTH of these URIs to your OAuth client's Authorized redirect URIs:
#   1. https://gmail-mcp.example.com/oauth/google-callback   (for sign-in)
#   2. https://gmail-mcp.example.com/oauth/callback          (for additional accounts)
GMAIL_MCP_OAUTH_REDIRECT_URI=https://gmail-mcp.example.com/oauth/callback

# ----- Allowlist (defence-in-depth on top of GCC Test Users gate) -----
# OPTIONAL. Leave both empty if you rely solely on GCC Testing-mode test users
# as your gate. Set one or both to add a second layer.
# Comma-separated. Example: ice.com,partnerco.com
GMAIL_MCP_ALLOWED_DOMAINS=
# Comma-separated. Example: sid@ice.com,abhi@ice.com
GMAIL_MCP_ALLOWED_EMAILS=

# ----- Storage -----
GMAIL_MCP_DATA_DIR=/data

# ----- Token TTLs -----
# Lifetime of access tokens issued to MCP clients (Claude Desktop). 30 days default.
GMAIL_MCP_ACCESS_TOKEN_TTL=2592000
