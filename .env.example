# ============================================================
# Gmail MCP server — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ----- Transport -----
# stdio = local single-user dev mode (no bearer auth)
# http  = remote multi-tenant mode (bearer auth required)
GMAIL_MCP_TRANSPORT=http

# Only used in http mode
GMAIL_MCP_HTTP_HOST=0.0.0.0
GMAIL_MCP_HTTP_PORT=8765

# Public base URL — what users hit in their browser for OAuth.
# Must match the protocol/host that nginx serves to the public.
# Example: https://gmail-mcp.example.com
GMAIL_MCP_PUBLIC_BASE_URL=https://gmail-mcp.example.com

# ----- Encryption -----
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DO NOT change this after users have connected accounts (existing tokens become unrecoverable).
GMAIL_MCP_ENCRYPTION_KEY=replace_me_with_a_real_fernet_key

# ----- Google OAuth client (from Google Cloud Console > Credentials) -----
GMAIL_MCP_OAUTH_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GMAIL_MCP_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# Must EXACTLY match an Authorized redirect URI in your OAuth client.
GMAIL_MCP_OAUTH_REDIRECT_URI=https://gmail-mcp.example.com/oauth/callback

# ----- Storage -----
# Where the SQLite DB lives. In Docker, mount this dir as a volume.
GMAIL_MCP_DATA_DIR=/data
